# Public Supabase project configuration.
# These values are safe to expose to the browser only when Supabase RLS
# policies are correctly configured. Never put a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Used only by the dashboard authentication flow.
SUPABASE_ADMIN_EMAIL=admin@example.com

# The dashboard expects the admin password/PIN to be managed by Supabase Auth.
# Do not store it in this file. Set or rotate it in Supabase Auth instead.
